// prisma/schema.prisma

// Define o gerador de cliente do Prisma.
// Ele será usado para criar o cliente tipado para interagir com o banco de dados.
generator client {
  provider = "prisma-client-js"
}

// Define a fonte de dados.
// Estamos dizendo ao Prisma que nosso banco de dados é um MongoDB.
// A URL do banco de dados será lida de uma variável de ambiente no arquivo .env
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================================
//   MODELO DE USUÁRIO
// ============================================================================
// Este é o modelo principal da nossa aplicação. Cada documento nesta coleção
// representará um cliente do BoTRT.
model User {
  // --- Campos de Identificação ---
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  email       String @unique // O e-mail do usuário, usado para login e comunicação. Deve ser único.
  auth0UserId String @unique // O ID do usuário fornecido pelo Auth0. É a nossa ligação segura com o sistema de identidade.

  // --- Sub-documento com informações do Stripe ---
  // Este campo é opcional (?) porque um usuário pode se cadastrar via Auth0
  // antes de efetivamente fazer uma assinatura no Stripe.
  stripe StripeInfo?

  // --- Timestamps ---
  // Datas de criação e atualização, gerenciadas automaticamente pelo Prisma.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
//   TIPO COMPOSTO PARA DADOS DO STRIPE
// ============================================================================
// No MongoDB, podemos aninhar objetos dentro de um documento. Este "type"
// define a estrutura do objeto 'stripe' que será aninhado dentro do modelo 'User'.
type StripeInfo {
  customerId       String // O ID do cliente no Stripe (cus_...). Essencial para gerenciar faturas e pagamentos.
  subscriptionId   String? // O ID da assinatura ativa (sub_...).
  status           String? // O status da assinatura (ex: "active", "canceled", "past_due").
  currentPeriodEnd DateTime? // A data em que o período de assinatura atual termina e a próxima cobrança ocorrerá.
}
